    <craft:has_subsumed_PR_class>http://purl.obolibrary.org/obo/PR_000016655</craft:has_subsumed_PR_class>
    <rdfs:label>TIF1</rdfs:label>
    <obo:IAO_0000115>Any of the members of the TIF1 family, including TRIM24 (TIF1alpha), TRIM28 (TIF1beta), and TRIM33 (TIF1gamma), in the form of DNA, RNA, or peptide.</obo:IAO_0000115>
    <craft:annotatable_text>TIF-1; TIF 1; TIF1; transcription intermediary factor 1; transcriptional intermediary factor 1</craft:annotatable_text>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_amyloid_beta_42">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_PR_extension_class"/>
    <rdfs:label>amyloid beta 42</rdfs:label>
    <obo:IAO_0000115>An amyloid beta 42, a 42-amino acid peptide that is a component of amyloid plaques found in the brains of people with Alzheimer's disease.</obo:IAO_0000115>
    <craft:has_substitutable_PR_class>http://purl.obolibrary.org/obo/PR_000025583</craft:has_substitutable_PR_class>
