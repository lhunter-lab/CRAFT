    <craft:has_subsumed_PR_class>http://purl.obolibrary.org/obo/PR_000010151</craft:has_subsumed_PR_class>
    <craft:has_subsumed_PR_class>http://purl.obolibrary.org/obo/PR_000010163</craft:has_subsumed_PR_class>
    <rdfs:label>JNK</rdfs:label>
    <obo:IAO_0000115>Any of the c-Jun N-terminal kinases, in either gene or gene product form, i.e., JNK1 (MAPK8), JNK2 (MAPK9), or JNK3 (MAPK10).</obo:IAO_0000115>
    <craft:annotatable_text>c-Jun N-terminal kinase; c-Jun N-terminal kinases; JNK; JNKs</craft:annotatable_text>
  </owl:Class>
