  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_wild_type_attribute_or_bearer">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_SO_extension_class"/>
    <craft:has_deductively_entailed_SO_class>http://purl.obolibrary.org/obo/SO_0000817</craft:has_deductively_entailed_SO_class>
    <obo:IAO_0000115>An attribute of a genotype being found in nature and/or in standard laboratory stock; or, a bearer of such an attribute.</obo:IAO_0000115>
    <rdfs:label>wild-type attribute or bearer</rdfs:label>
    <craft:annotatable_text>wild; wildtype; wild-type; wild type; wild types; wt; WTs</craft:annotatable_text>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_evolutionary_conservation">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_SO_extension_class"/>
    <craft:has_deductively_entailed_SO_class>http://purl.obolibrary.org/obo/SO_0000856</craft:has_deductively_entailed_SO_class>
    <obo:IAO_0000115>An occurrence of the maintenance by natural selection of the presence of identical biomacromolecular sequences or phenotypes across species; or, an attribute of such an occurrence, e.g., of being or having been maintained in such a manner.</obo:IAO_0000115>
    <rdfs:label>occurrence/attribute of evolutionary conservation</rdfs:label>
    <craft:annotatable_text>conservation; conservations; conserve; conserves; conserved; conserving; evolutionary conservation; evolutionary conservations; evolutionarily conserved</craft:annotatable_text>
  </owl:Class>
