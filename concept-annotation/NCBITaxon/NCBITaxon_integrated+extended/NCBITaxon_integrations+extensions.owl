      </owl:AnnotationProperty>
    </rdfs:subPropertyOf>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_fruit_fly">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_NCBITaxon_extension_class"/>
    <craft:has_subsuming_NCBITaxon_class_with_organism_or_taxon_interpretation>http://purl.obolibrary.org/obo/NCBITaxon_43741</craft:has_subsuming_NCBITaxon_class_with_organism_or_taxon_interpretation>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_7211</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_7215</craft:has_subsumed_NCBITaxon_class>
    <rdfs:label>fruit fly</rdfs:label>
    <craft:annotatable_text>fruit fly; fruit flies</craft:annotatable_text>
    <obo:IAO_0000115>A fly of either the genus Drosophila or of the family Tephritidae, each of which are referred to as fruit flies.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_coral">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_NCBITaxon_extension_class"/>
    <craft:has_subsuming_NCBITaxon_class_with_organism_or_taxon_interpretation>http://purl.obolibrary.org/obo/NCBITaxon_6101</craft:has_subsuming_NCBITaxon_class_with_organism_or_taxon_interpretation>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_6102</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_6132</craft:has_subsumed_NCBITaxon_class>
    <rdfs:label>coral</rdfs:label>
    <craft:annotatable_text>coral; corals</craft:annotatable_text>
    <obo:IAO_0000115>A colonial marine intervertebrate within the subphylum Anthozoa of the phylum Cnidaria, typically forming compact colonies of many identical individual polyps. Coral species include important reef builders that inhabit tropical oceans and secrete calcium carbonate to form a hard skeleton.</obo:IAO_0000115>
  </owl:Class>
