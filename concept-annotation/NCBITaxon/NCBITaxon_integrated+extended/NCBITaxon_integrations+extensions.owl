    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_6073</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_7586</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_7712</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_7735</craft:has_subsumed_NCBITaxon_class>
    <rdfs:label>invertebrate</rdfs:label>
    <craft:annotatable_text>invertebrate; invertebrates</craft:annotatable_text>
    <obo:IAO_0000115>An animal that neither develops nor retains a vertebral column. The invertebrates include all animals excluding the chordate subphylum Vertebrata, i.e., the vertebrates. Well-known taxa of invertebrates include arthropods, mollusks, annelids, echinoderms, flatworms, cnidarians, and sponges.</obo:IAO_0000115>
  </owl:Class>
