    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_10298</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_10310</craft:has_subsumed_NCBITaxon_class>
    <rdfs:label>HSV</rdfs:label>
    <craft:annotatable_text>herpes simplex virus; herpes simplex viruses; HSV</craft:annotatable_text>
    <obo:IAO_0000115>One of herpes simplex virus 1 or 2 (HSV-1/HSV-2), of the genus Simplexvirus, each a common and contagious virus that can infect humans.</obo:IAO_0000115>
  </owl:Class>
