    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_1141643</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_1141645</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_226848</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_337729</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_45485</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_9996</craft:has_subsumed_NCBITaxon_class>
    <rdfs:label>ground squirrel</rdfs:label>
    <craft:annotatable_text>ground squirrel; ground squirrels</craft:annotatable_text>
    <obo:IAO_0000115>A member of any of the species commonly referred to as ground squirrels, within the Xerinae subfamily of squirrels and specifically from the subtaxa Ammospermophilus, Callospermophilus, Ictidomys, Notocitellus, Otospermophilus, Poliocitellus, Sciurotamias, Spermophilus, Urocitellus, Xerini, and Xerospermophilus. This extension class excludes the Xerinae subtaxa Marmota (members of which are typically referred to as marmots), Neotamias and Tamias (members of which are typically referred to as chipmunks), and Protoxerini (members of which are variously referred to as bush squirrels, giant squirrels, palm squirrels, pygmy squirrels, striped squirrels, or sun squirrels).</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_woman">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_NCBITaxon_extension_class"/>
