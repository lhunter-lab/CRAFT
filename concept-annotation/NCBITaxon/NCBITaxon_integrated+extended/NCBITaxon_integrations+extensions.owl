    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_1141636</craft:has_subsumed_NCBITaxon_class>
    <craft:has_subsumed_NCBITaxon_class>http://purl.obolibrary.org/obo/NCBITaxon_1141637</craft:has_subsumed_NCBITaxon_class>
