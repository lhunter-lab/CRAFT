  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_attribute_of_pericellular_association">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_CC_extension_class"/>
    <rdfs:label>attribute of pericellular association</rdfs:label>
    <craft:has_deductively_entailed_GO_CC_class>http://purl.obolibrary.org/obo/GO_0110165</craft:has_deductively_entailed_GO_CC_class>
    <craft:annotatable_text>pericellular; peri-cellular; pericellularly; peri-cellularly</craft:annotatable_text>
    <obo:IAO_0000115>An attribute of some kind of association (e.g., existing, inhering, of being situated, of taking place) around or near one or more cells.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_very_low_density_lipoprotein_particle">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_CC_extension_class"/>
    <rdfs:label>very-low-density lipoprotein particle</rdfs:label>
    <craft:has_substitutable_GO_CC_class>http://purl.obolibrary.org/obo/GO_0034361</craft:has_substitutable_GO_CC_class>
    <craft:annotatable_text>very-low-density lipoprotein; very-low-density lipoproteins; very-low-density lipoprotein particle; very-low-density lipoprotein particles; very low density lipoprotein; very low density lipoproteins; very low density lipoprotein particle; very low density lipoprotein particles; VLDL; VLDLs; VLDL lipoprotein; VLDL lipoproteins; VLDL particle; VLDL particles</craft:annotatable_text>
    <obo:IAO_0000115>A lipoprotein of large size (30-80 nm), very-low-density (0.93-1.006 g/ml) particle with a core composed mainly of triglycerides and a surface monolayer of phospholipids and cholesterol into which are embedded the apolipoproteins B, E, and C. VLDLs facilitate the transport of endogenously made triglycerides to extrahepatic tissues.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_high_density_lipoprotein_particle">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_CC_extension_class"/>
