    <craft:has_substitutable_GO_CC_class>http://purl.obolibrary.org/obo/GO_0034364</craft:has_substitutable_GO_CC_class>
    <craft:annotatable_text>HDL; HDLs; HDL lipoprotein; HDL lipoproteins; HDL particle; HDL paraticles; high-density lipoprotein; high-density lipoproteins; high density lipoprotein; high density lipoproteins; high-density lipoprotein particle; high-density lipoprotein particles; high density lipoprotein particle; high density lipoprotein particles</craft:annotatable_text>
    <obo:IAO_0000115>A lipoprotein particle with a high density (typically 1.063-1.21 g/ml) and a diameter of 5-10 nm that contains APOAs and may contain APOCs and APOE.</obo:IAO_0000115>
  </owl:Class>
