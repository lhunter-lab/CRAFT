  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_misexpression">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
