    <obo:IAO_0000115>An attribute of not having some kind of association with (e.g., involving, being involved in) inflammation.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_translational_stop_site_or_occurrence">
