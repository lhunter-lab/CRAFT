    <craft:has_subsumed_GO_BP_class>http://purl.obolibrary.org/obo/GO_0001172</craft:has_subsumed_GO_BP_class>
    <craft:has_subsumed_GO_BP_class>http://purl.obolibrary.org/obo/GO_0006351</craft:has_subsumed_GO_BP_class>
    <craft:has_subsumed_GO_BP_class>http://purl.obolibrary.org/obo/GO_0019083</craft:has_subsumed_GO_BP_class>
    <craft:annotatable_text>transcribe; transcribes; transcribed; transcribing; transcription; transcriptions; transcriptional; transcriptionally</craft:annotatable_text>
    <obo:IAO_0000115>An occurrence of DNA-templated transcription, RNA-templated transcription, reverse transcription, or viral transcription; or, an attribute of such an occurrence, e.g., of being, becoming, or having been transcribed.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_DNA_recombineering">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
