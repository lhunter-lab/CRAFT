    <rdfs:label>absence of synapsis</rdfs:label>
    <craft:annotatable_text>asynapsis</craft:annotatable_text>
    <obo:IAO_0000115>An absence of chromosomal synapsis, i.e., homologous pairing at meiosis.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_transcription">
