    <craft:has_subsumed_GO_BP_class>http://purl.obolibrary.org/obo/GO_0061061</craft:has_subsumed_GO_BP_class>
    <craft:annotatable_text>development of muscle; formation of muscle; muscle development; muscle formation; muscularisation; muscularise; muscularises; muscularised; muscularising; muscularization; muscularizes; muscularized; muscularizing; myogenesis; myogenic</craft:annotatable_text>
    <obo:IAO_0000115>An occurrence of muscle formation or development; or, an attribute of such an occurrence, e.g., of being, becoming, or having become muscularized.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_negative_regulation">
