  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_dysmorphogenesis">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
    <craft:has_deductively_entailed_GO_BP_class>http://purl.obolibrary.org/obo/GO_0009653</craft:has_deductively_entailed_GO_BP_class>
    <rdfs:label>occurrence/attribute of dysmorphogenesis</rdfs:label>
    <craft:annotatable_text>dysmorphogenesis; dysmorphogenetic; dysmorphogenic</craft:annotatable_text>
    <obo:IAO_0000115>An occurrence of abnormal morphogenesis; or, an attribute of such an occurrence, e.g., of involving or being involved with such an occurrence.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_formation_or_development_of_muscle">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
