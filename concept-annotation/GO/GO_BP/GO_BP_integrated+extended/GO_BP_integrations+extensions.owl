  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_material_innervation_or_occurrence_or_attribute_of_innervation">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
