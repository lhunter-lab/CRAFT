    <rdfs:label>biological process occurrence, attribute or study</rdfs:label>
    <craft:annotatable_text>physiology</craft:annotatable_text>
    <obo:IAO_0000115>An occurrence of a biological process; or, an attribute of a biological process (e.g., an attribute of involving a biological process); or, the study of biological processes.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_developmental_differentiation">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
    <rdfs:label>occurrence/attribute of developmental differentiation</rdfs:label>
