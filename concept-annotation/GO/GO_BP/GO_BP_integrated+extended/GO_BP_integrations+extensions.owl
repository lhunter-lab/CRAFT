    <obo:IAO_0000115>An occurrence of DNA recombineering, in which DNA is engineered/modified using DNA recombination; or, an attribute of such an occurrence, e.g., of being, becoming, or having become engineered/modified as such.</obo:IAO_0000115>
  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_occurrence_or_attribute_of_prodifferentiative_activity">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
