  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_attribute_of_premeiotic_association">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
