  </owl:Class>
  <owl:Class rdf:about="http://craftcorpus.org/CRAFT_biological_process_occurrence_or_attribute_or_study">
    <rdfs:subClassOf rdf:resource="http://craftcorpus.org/CRAFT_GO_BP_extension_class"/>
